{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hp-eligo",
	"main": "worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
		// 生成済みページの保存領域（会員ページも含む）は直接配信させず、worker.ts で遮断する
		"run_worker_first": ["/cdn-cgi/_next_cache/*"]
	},
	"services": [
		{
			// 自分自身への参照（OpenNext のキャッシュ処理が使う）。name と一致させる
			"binding": "WORKER_SELF_REFERENCE",
			"service": "hp-eligo"
		}
	],
	"images": {
		// next/image の画像最適化に Cloudflare Images を使う
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	}
}
